            }
          }
        },
        {
          "name": "GET /teams/:team_id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{core_url}}/api/core/v1/teams/:team_id",
              "host": ["{{core_url}}"],
              "path": ["api", "core", "v1", "teams", ":team_id"],
