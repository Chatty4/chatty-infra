{
  "info": {
    "name": "chatty",
    "description": "All routes in chatty-core and chatty-chat.\n\n1. Select the \"Chatty local\" environment (chatty-local.postman_environment.json).\n2. Run Auth > register once, then login. Login saves access_token and refresh_token.\n3. Internal uses service_token from the environment: the dev default change-me. If chatty-infra/.env sets another CORE_SERVICE_TOKEN, use that.\n\nThe WebSocket (GET {{chat_url}}/api/chat/v1/ws?token={{access_token}}) can't be stored in a collection file: open it in Postman with New > WebSocket.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "team_id", "value": "" },
    { "key": "channel_id", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "invite_id", "value": "" },
    { "key": "invite_code", "value": "" },
    { "key": "dm_id", "value": "" },
    { "key": "me_id", "value": "" },
    { "key": "client_msg_id", "value": "" },
    { "key": "message_id", "value": "" }
  ],
  "item": [
    {
      "name": "Core health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{core_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Chat health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{chat_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "url": "{{core_url}}/api/core/v1/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"display_name\": \"{{display_name}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var body = pm.response.json();",
                  "if (body.access_token) pm.collectionVariables.set('access_token', body.access_token);",
                  "if (body.refresh_token) pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{core_url}}/api/core/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var body = pm.response.json();",
                  "if (body.access_token) pm.collectionVariables.set('access_token', body.access_token);",
                  "if (body.refresh_token) pm.collectionVariables.set('refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{core_url}}/api/core/v1/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/password (change password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// swap so login keeps working and the next run changes it back",
                  "if (pm.response.code === 204) {",
                  "    var old = pm.environment.get('password');",
                  "    pm.environment.set('password', pm.environment.get('new_password'));",
                  "    pm.environment.set('new_password', old);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{core_url}}/api/core/v1/auth/password",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"{{password}}\",\n  \"new_password\": \"{{new_password}}\",\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "url": "{{core_url}}/api/core/v1/auth/logout",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        }
      ]
    },
