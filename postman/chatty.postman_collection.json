              "raw": "{{core_url}}/api/core/v1/channels/:channel_id/members/:user_id",
              "host": ["{{core_url}}"],
              "path": ["api", "core", "v1", "channels", ":channel_id", "members", ":user_id"],
              "variable": [
                { "key": "channel_id", "value": "{{channel_id}}" },
                { "key": "user_id", "value": "{{user_id}}" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "DMs",
      "item": [
        {
          "name": "POST /teams/:team_id/dms",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('dm_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{core_url}}/api/core/v1/teams/:team_id/dms",
              "host": ["{{core_url}}"],
              "path": ["api", "core", "v1", "teams", ":team_id", "dms"],
              "variable": [{ "key": "team_id", "value": "{{team_id}}" }]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_ids\": [\"{{user_id}}\"]\n}"
            }
          }
        },
        {
          "name": "PUT /channels/:dm_id/me (hide DM)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{core_url}}/api/core/v1/channels/:channel_id/me",
              "host": ["{{core_url}}"],
              "path": ["api", "core", "v1", "channels", ":channel_id", "me"],
              "variable": [{ "key": "channel_id", "value": "{{dm_id}}" }]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notify_level\": \"all\",\n  \"muted\": false,\n  \"hidden\": true\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Messages (chatty-chat)",
      "item": [
        {
          "name": "POST /channels/:channel_id/messages",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// a new message each run; send it twice without this to see the retry (200)",
                  "pm.collectionVariables.set('client_msg_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('message_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{chat_url}}/api/chat/v1/channels/:channel_id/messages",
              "host": ["{{chat_url}}"],
              "path": ["api", "chat", "v1", "channels", ":channel_id", "messages"],
              "variable": [{ "key": "channel_id", "value": "{{channel_id}}" }]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_msg_id\": \"{{client_msg_id}}\",\n  \"body\": \"deploy at 5? <@{{me_id}}>\"\n}"
            }
          }
        },
        {
          "name": "GET /channels/:channel_id/messages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{chat_url}}/api/chat/v1/channels/:channel_id/messages?limit=50",
              "host": ["{{chat_url}}"],
              "path": ["api", "chat", "v1", "channels", ":channel_id", "messages"],
              "query": [
                { "key": "limit", "value": "50", "description": "1-100" },
                { "key": "before_seq", "value": "", "disabled": true, "description": "older than this seq; for scrolling up" }
              ],
              "variable": [{ "key": "channel_id", "value": "{{channel_id}}" }]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ]
          }
        },
        {
          "name": "PUT /messages/:message_id",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{chat_url}}/api/chat/v1/messages/:message_id",
              "host": ["{{chat_url}}"],
              "path": ["api", "chat", "v1", "messages", ":message_id"],
              "variable": [{ "key": "message_id", "value": "{{message_id}}" }]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"deploy at 6? <@{{me_id}}>\"\n}"
            }
          }
        },
        {
          "name": "DELETE /messages/:message_id",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{chat_url}}/api/chat/v1/messages/:message_id",
              "host": ["{{chat_url}}"],
              "path": ["api", "chat", "v1", "messages", ":message_id"],
              "variable": [{ "key": "message_id", "value": "{{message_id}}" }]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Sync (chatty-chat)",
      "item": [
        {
          "name": "POST /sync",
          "request": {
            "method": "POST",
            "url": "{{chat_url}}/api/chat/v1/sync",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cursors\": {\n    \"{{channel_id}}\": 0\n  }\n}"
            }
          }
        },
        {
          "name": "GET /channels/:channel_id/events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{chat_url}}/api/chat/v1/channels/:channel_id/events?after_seq=0&limit=500",
              "host": ["{{chat_url}}"],
              "path": ["api", "chat", "v1", "channels", ":channel_id", "events"],
              "query": [
                { "key": "after_seq", "value": "0", "description": "required: the last seq the web app has" },
                { "key": "limit", "value": "500", "description": "1-500" }
              ],
              "variable": [{ "key": "channel_id", "value": "{{channel_id}}" }]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Internal (chatty-core, for chatty-chat)",
      "item": [
        {
          "name": "GET /internal/users/:user_id/memberships",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{core_url}}/internal/users/:user_id/memberships",
              "host": ["{{core_url}}"],
              "path": ["internal", "users", ":user_id", "memberships"],
              "variable": [{ "key": "user_id", "value": "{{me_id}}" }]
            },
            "header": [
              { "key": "X-Service-Token", "value": "{{service_token}}" }
            ]
          }
        },
        {
          "name": "GET /internal/channels/:channel_id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{core_url}}/internal/channels/:channel_id",
              "host": ["{{core_url}}"],
              "path": ["internal", "channels", ":channel_id"],
              "variable": [{ "key": "channel_id", "value": "{{channel_id}}" }]
            },
            "header": [
              { "key": "X-Service-Token", "value": "{{service_token}}" }
            ]
          }
        }
      ]
    }
  ]
}
