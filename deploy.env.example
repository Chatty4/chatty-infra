# Settings for deploy.sh's web container, on the server only.
# Copy to deploy.env next to deploy.sh (never committed) and fill it in.
# Read the current values once from the running container: docker inspect <name>

# The container's name; deploy.sh removes and starts it again under this name.
WEB_CONTAINER=chatty-web

# docker run -p: "80:80" to serve on port 80 directly, "127.0.0.1:8080:80" behind a reverse proxy.
WEB_PUBLISH=80:80

# The MinIO address the browser uses (chatty-core's MINIO_PUBLIC_URL). Nginx puts it in the
# page's security policy: a wrong one blocks images and file previews.
MINIO_PUBLIC_URL=https://files.example.com

# Public keys, built into the JavaScript: the same values as chatty-web/.env.
# Empty turns that feature off (push notifications, the GIF picker).
VITE_VAPID_PUBLIC_KEY=
VITE_GIPHY_API_KEY=
