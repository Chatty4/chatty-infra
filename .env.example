# Local development values. Copy to .env to override: cp .env.example .env
# These are not secrets; never reuse them outside your machine.

# chatty-core Postgres
CORE_DB_USER=core_user
CORE_DB_PASSWORD=core_pass
CORE_DB_NAME=core_db
CORE_DB_PORT=5432

# chatty-chat Postgres
CHAT_DB_USER=chat_user
CHAT_DB_PASSWORD=chat_pass
CHAT_DB_NAME=chat_db
CHAT_DB_PORT=5433

# Redis
REDIS_PORT=6379

# MinIO (API and web console at http://localhost:9001)
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Kafka (KRaft, single node)
KAFKA_PORT=9092

# chatty-core API (http://127.0.0.1:8000/health)
CORE_API_PORT=8000
# Django SECRET_KEY for the core container. Local only, not a secret
CORE_SECRET_KEY=dev-only-not-secret

# chatty-chat API (http://localhost:8001/health)
CHAT_API_PORT=8001

# Shared secret for chatty-core's internal API (X-Service-Token), used by both services
CORE_SERVICE_TOKEN=change-me
